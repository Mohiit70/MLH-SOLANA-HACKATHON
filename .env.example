NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
SOLANA_RPC_SERVER=https://api.devnet.solana.com
# AI explanation is provider-agnostic (plain fetch, no SDK).
# AI_PROVIDER: "gemini" (default) or "openai-compatible" (Groq, OpenRouter, OpenAI).
# AI_MODEL: gemini default is gemini-3.5-flash (2.5-flash is retired for new keys).
#   openai-compatible default is openai/gpt-oss-120b (Groq).
# AI_API_KEY: your key for the provider — free from Google AI Studio (Gemini)
#   or Groq Console. Never commit a real key; put it in .env.local only.
# AI_BASE_URL: only for openai-compatible. Groq: https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1 — OpenAI: https://api.openai.com/v1
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=
AI_BASE_URL=
# Funded devnet PUBLIC address used as the demo fee payer when no wallet is
# connected, so simulation succeeds. Public address only — never a private key.
NEXT_PUBLIC_DEMO_PAYER=
